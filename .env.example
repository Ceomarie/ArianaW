# Copy to .env files inside each app. Both apps use the same Supabase project.
# These are the PUBLIC (anon) values — safe to ship in client apps. Never put
# the Supabase service_role key in any app; keep it server-side only.

# apps/web/.env  (Vite requires the VITE_ prefix)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# apps/mobile/.env  (Expo requires the EXPO_PUBLIC_ prefix)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
